PATCompositeTreeProducer6::PATCompositeTreeProducer6(const edm::ParameterSet& iConfig)
    : tok_genParticle_(consumes<reco::GenParticleCollection>(
          iConfig.getUntrackedParameter<edm::InputTag>("GenParticleCollection", edm::InputTag("genParticles")))),
      tok_offlinePV_(consumes<reco::VertexCollection>(
          iConfig.getUntrackedParameter<edm::InputTag>("VertexCollection", edm::InputTag("offlinePrimaryVertices")))),
      tok_generalTrk_(consumes<reco::TrackCollection>(
          iConfig.getUntrackedParameter<edm::InputTag>("TrackCollection", edm::InputTag("generalTracks")))),
      doRecoNtuple_(iConfig.getUntrackedParameter<bool>("doRecoNtuple", false)),
      doGenMatching_(iConfig.getUntrackedParameter<bool>("doGenMatching", true)),
      doGenNtuple_(iConfig.getUntrackedParameter<bool>("doGenNtuple", true)),
      doGenMatchingTOF_(iConfig.getUntrackedParameter<bool>("doGenMatchingTOF", false)),
      hasSwap_(iConfig.getUntrackedParameter<bool>("hasSwap", true)),
      decayInGen_(iConfig.getUntrackedParameter<bool>("decayInGen", true)),
      twoLayerDecay_(iConfig.getUntrackedParameter<bool>("twoLayerDecay", true)),
      useAnyMVA_(false),
      isSkimMVA_(iConfig.getUntrackedParameter<bool>("isSkimMVA", false)),
      doRunInfo_(true),
      isCentrality_(false),
      debugGenMatching_(iConfig.getUntrackedParameter<bool>("debugGenMatching", false)),
      verboseDebug_(iConfig.getUntrackedParameter<bool>("verboseDebug", false)),
      isEventPlane_(false),
      hasEventplaneSrcToken_(false),
      hasCompositeCandidatesToken_(false),
      pid_(iConfig.getUntrackedParameter<int>("PID", 413)),
      pidDau1_(iConfig.getUntrackedParameter<int>("PID_dau1", 421)),
      pidDau2_(iConfig.getUntrackedParameter<int>("PID_dau2", 211)),
      deltaR_(iConfig.getUntrackedParameter<double>("deltaR", 0.03)),
      multMax_(iConfig.getUntrackedParameter<double>("multMax", -1)),
      multMin_(iConfig.getUntrackedParameter<double>("multMin", -1)),
      Ntrkoffline(0),
      Npixel(-99),
      centrality(-99),
      candSize(0),
      runNb(0),
      lsNb(0),
      eventNb(0),
      bestvx(kInvalidValue),
      bestvy(kInvalidValue),
      bestvz(kInvalidValue),
      HFsumETPlus(kInvalidValue),
      HFsumETMinus(kInvalidValue),
      ZDCPlus(kInvalidValue),
      ZDCMinus(kInvalidValue),
      ephfSumW(-99.f),
      PATCompositeNtuple_(nullptr),
      candSize_gen(0),
      nEventsProcessed_(0),
      nEventsFillRECO_(0),
      nRecoCandidatesProcessed_(0),
      nRecoCandidatesMatched_(0),
      nEventsFillGEN_(0) {
  useAnyMVA_ =
      (iConfig.existsAs<bool>("useAnyMVA") ? iConfig.getParameter<bool>("useAnyMVA")
                                           : iConfig.getUntrackedParameter<bool>("useAnyMVA", false));
  doRunInfo_ =
      (iConfig.existsAs<bool>("doRunInfo") ? iConfig.getParameter<bool>("doRunInfo")
                                           : iConfig.getUntrackedParameter<bool>("doRunInfo", true));
  isCentrality_ =
      (iConfig.existsAs<bool>("isCentrality") ? iConfig.getParameter<bool>("isCentrality")
                                              : iConfig.getUntrackedParameter<bool>("isCentrality", false));
  isEventPlane_ =
      (iConfig.existsAs<bool>("isEventPlane") ? iConfig.getParameter<bool>("isEventPlane")
                                              : iConfig.getUntrackedParameter<bool>("isEventPlane", false));

  auto mvaTag = edm::InputTag();
  if (iConfig.existsAs<edm::InputTag>("MVACollection")) mvaTag = iConfig.getParameter<edm::InputTag>("MVACollection");
  else mvaTag = iConfig.getUntrackedParameter<edm::InputTag>("MVACollection", edm::InputTag());
  if (!mvaTag.label().empty()) tok_mvaValues_ = consumes<MVACollection>(mvaTag);

  tok_dedx1_ = consumes<edm::ValueMap<reco::DeDxData>>(edm::InputTag("dedxHarmonic2"));
  tok_dedx2_ = consumes<edm::ValueMap<reco::DeDxData>>(edm::InputTag("dedxTruncated40"));

  const auto compTag = iConfig.getUntrackedParameter<edm::InputTag>("CompositeCollection", edm::InputTag());
  if (!compTag.label().empty()) {
    tok_compositeCandidates_ = consumes<CCC>(compTag);
    hasCompositeCandidatesToken_ = true;
  }
  if (isCentrality_) {
    if (iConfig.existsAs<edm::InputTag>("centralityBinLabel")) {
      tok_centBinLabel_ = consumes<int>(iConfig.getParameter<edm::InputTag>("centralityBinLabel"));
    } else {
      tok_centBinLabel_ = consumes<int>(iConfig.getUntrackedParameter<edm::InputTag>("centralityBinLabel", edm::InputTag()));
    }
    if (iConfig.existsAs<edm::InputTag>("centralitySrc")) {
      tok_centSrc_ = consumes<reco::Centrality>(iConfig.getParameter<edm::InputTag>("centralitySrc"));
    } else {
      tok_centSrc_ = consumes<reco::Centrality>(iConfig.getUntrackedParameter<edm::InputTag>("centralitySrc", edm::InputTag()));
    }
  }
  if (isEventPlane_) {
    edm::InputTag epTag;
    if (iConfig.existsAs<edm::InputTag>("eventplaneSrcRecalc")) epTag = iConfig.getParameter<edm::InputTag>("eventplaneSrcRecalc");
    else epTag = iConfig.getUntrackedParameter<edm::InputTag>("eventplaneSrcRecalc", edm::InputTag());
    if (!epTag.label().empty()) {
      tok_eventplaneSrc_ = consumes<reco::EvtPlaneCollection>(epTag);
      hasEventplaneSrcToken_ = true;
    }
  }
}

void PATCompositeTreeProducer6::beginJob() {
  if (doRecoNtuple_ || doGenNtuple_) initTree();
  if (!doRecoNtuple_ && !doGenMatching_ && !doGenNtuple_) {
    edm::LogWarning("PAT6GenMatching")
        << "doRecoNtuple, doGenMatching, doGenNtuple are all false. Nothing will be processed.";
  }
  if (doRecoNtuple_ && !hasCompositeCandidatesToken_) {
    edm::LogWarning("PAT6GenMatching")
        << "doRecoNtuple=true but CompositeCollection is not configured. fillRECO will be skipped.";
  }
}

void PATCompositeTreeProducer6::getAncestorId(const reco::Candidate& gCand,
                                              int& genAncestorId,
                                              int& genAncestorFlavor) const {
  genAncestorId = 0;
  genAncestorFlavor = 0;
  const reco::Candidate* mom = &gCand;
  int depth = 0;
  constexpr int kMaxDepth = 50;
  while (mom != nullptr && depth < kMaxDepth) {
    if (depth > 0) {
      const int currentId = mom->pdgId();
      const int absId = std::abs(currentId);
      genAncestorId = currentId;
      const std::string idstr = std::to_string(absId);
      if (!idstr.empty()) genAncestorFlavor = std::stoi(std::string{idstr.begin(), idstr.begin() + 1});
      if (!idstr.empty() && idstr[0] == '5') break;
      if (absId <= 40) break;
    }
    mom = mom->mother();
    ++depth;
  }
}

PATCompositeTreeProducer6::D0DaughterSummary PATCompositeTreeProducer6::summarizeD0Daughters(const reco::Candidate* d0) const {
  D0DaughterSummary out;
  if (!d0) return out;
  for (size_t idau = 0; idau < d0->numberOfDaughters(); ++idau) {
    const auto* dau = d0->daughter(idau);
    if (!dau) continue;
    const int absId = std::abs(dau->pdgId());
    if (absId == kPdgGamma) {
      ++out.gammaCount;
      continue;
    }
    ++out.nonGammaCount;
    if (absId == kPdgKaon) out.hasKaon = true;
    if (absId == kPdgPion) out.hasPion = true;
  }
  return out;
}

