std::vector<reco::GenParticleRef> PATCompositeTreeProducer6::processGenMatching(const edm::Handle<reco::GenParticleCollection>& genpars) {
  std::vector<reco::GenParticleRef> genRefs;

  auto hasKPiFromDaughters = [&](const reco::Candidate* cand) {
    if (!cand || cand->numberOfDaughters() < 2) { return false; }
    std::vector<unsigned int> perm(2);
    std::iota(perm.begin(), perm.end(), 0);
    std::sort(perm.begin(), perm.end());
    do {
      const reco::Candidate* d1 = cand->daughter(perm[0]);
      const reco::Candidate* d2 = cand->daughter(perm[1]);
      if (!d1 || !d2) { continue;}
      if (std::abs(d1->pdgId()) == kPdgKaon && std::abs(d2->pdgId()) == kPdgPion) { return true; }
    } while (std::next_permutation(perm.begin(), perm.end()));
    return false;
  };

  auto hasKPiGammaFromDaughters = [&](const reco::Candidate* cand) {
    if (!cand || cand->numberOfDaughters() < 3) {
      return false;
    }
    std::vector<unsigned int> perm(3);
    std::iota(perm.begin(), perm.end(), 0);
    std::sort(perm.begin(), perm.end());
    do {
      const reco::Candidate* d1 = cand->daughter(perm[0]);
      const reco::Candidate* d2 = cand->daughter(perm[1]);
      const reco::Candidate* d3 = cand->daughter(perm[2]);
      if (!d1 || !d2 || !d3) {
        continue;
      }
      if (std::abs(d1->pdgId()) == kPdgKaon && std::abs(d2->pdgId()) == kPdgPion &&
          std::abs(d3->pdgId()) == kPdgGamma) {
        return true;
      }
    } while (std::next_permutation(perm.begin(), perm.end()));
    return false;
  };

  if (!doGenMatching_) {
    return genRefs;
  }

  if (!genpars.isValid()) {
    return genRefs;
  }

  for (unsigned int it = 0; it < genpars->size(); ++it) {
    const reco::GenParticle& trk = (*genpars)[it];
    const int id = trk.pdgId();

    if (std::abs(id) != std::abs(pid_)) {
      continue;
    }

    if (!decayInGen_) {
      genRefs.emplace_back(genpars, it);
      continue;
    }

    int dstarGammaCount = 0;
    std::vector<unsigned int> dstarNonGammaIdx;
    dstarNonGammaIdx.reserve(trk.numberOfDaughters());
    for (size_t idau = 0; idau < trk.numberOfDaughters(); ++idau) {
      const reco::Candidate* dau = trk.daughter(idau);
      if (!dau) {
        continue;
      }
      if (std::abs(dau->pdgId()) == kPdgGamma) {
        ++dstarGammaCount;
      } else {
        dstarNonGammaIdx.push_back(static_cast<unsigned int>(idau));
      }
    }

    if (twoLayerDecay_ && dstarGammaCount > 0) {
      continue;
    }

    if (dstarNonGammaIdx.size() != 2) {
      continue;
    }

    int idxLayer1 = -1;
    std::sort(dstarNonGammaIdx.begin(), dstarNonGammaIdx.end());
    do {
      const reco::Candidate* Dd1 = trk.daughter(dstarNonGammaIdx[0]);
      const reco::Candidate* Dd2 = trk.daughter(dstarNonGammaIdx[1]);
      if (!Dd1 || !Dd2) {
        continue;
      }
      if (std::abs(Dd1->pdgId()) == std::abs(pidDau1_) && std::abs(Dd2->pdgId()) == std::abs(pidDau2_)) {
        idxLayer1 = static_cast<int>(dstarNonGammaIdx[0]);
        break;
      }
    } while (std::next_permutation(dstarNonGammaIdx.begin(), dstarNonGammaIdx.end()));

    if (idxLayer1 < 0) {
      continue;
    }

    if (twoLayerDecay_) {
      const reco::Candidate* d0 = trk.daughter(static_cast<unsigned int>(idxLayer1));
      if (!d0) {
        continue;
      }

      int d0GammaCount = 0;
      int d0NonGammaCount = 0;
      for (size_t idau = 0; idau < d0->numberOfDaughters(); ++idau) {
        const reco::Candidate* dau = d0->daughter(idau);
        if (!dau) {
          continue;
        }
        if (std::abs(dau->pdgId()) == kPdgGamma) {
          ++d0GammaCount;
        } else {
          ++d0NonGammaCount;
        }
      }

      if (d0GammaCount > 0) {
        if (d0->numberOfDaughters() != 3 || d0NonGammaCount != 2 || d0GammaCount != 1) {
          continue;
        }
        if (!hasKPiGammaFromDaughters(d0)) {
          continue;
        }
      } else {
        if (d0->numberOfDaughters() != 2 || d0NonGammaCount != 2) {
          continue;
        }
        if (!hasKPiFromDaughters(d0)) {
          continue;
        }
      }

      genRefs.emplace_back(genpars, it);
    } else {
      const int singleLayerGammaCount = dstarGammaCount;
      const int singleLayerNonGammaCount = static_cast<int>(dstarNonGammaIdx.size());

      if (singleLayerGammaCount > 0) {
        if (trk.numberOfDaughters() != 3 || singleLayerNonGammaCount != 2 || singleLayerGammaCount != 1) {
          continue;
        }
        if (!hasKPiGammaFromDaughters(&trk)) {
          continue;
        }
      } else {
        if (trk.numberOfDaughters() != 2 || singleLayerNonGammaCount != 2) {
          continue;
        }
        if (!hasKPiFromDaughters(&trk)) {
          continue;
        }
      }

      genRefs.emplace_back(genpars, it);
    }
  }

  return genRefs;
}

void PATCompositeTreeProducer6::processCandidates(const CCC* v0candidates_,
                                                  const edm::Handle<MVACollection>& mvavalues,
                                                  const std::vector<reco::GenParticleRef>& genRefs,
                                                  const edm::Handle<edm::ValueMap<reco::DeDxData>>& dEdxHandle1,
                                                  const edm::Handle<edm::ValueMap<reco::DeDxData>>& dEdxHandle2,
                                                  const edm::Event& iEvent,
                                                  const edm::Handle<reco::VertexCollection>& vertices,
                                                  const edm::Handle<reco::GenParticleCollection>& genpars) {
  candSize = 0;
  if (!v0candidates_) return;
  const unsigned int nCandRaw = v0candidates_->size();
  const unsigned int nCand = std::min<unsigned int>(nCandRaw, static_cast<unsigned int>(kMaxGenCand));
  if (nCandRaw > nCand) {
    edm::LogWarning("PAT6GenMatching") << "Reco candidates (" << nCandRaw << ") exceed kMaxGenCand (" << kMaxGenCand
                                       << "); truncating.";
  }
  candSize = static_cast<int>(nCand);

  for (unsigned int it = 0; it < nCand; ++it) {
    resetCandidateOutputs(it);
    ++nRecoCandidatesProcessed_;
    const CC& trk = (*v0candidates_)[it];

    const reco::Candidate* d1 = trk.daughter(0);
    const reco::Candidate* d2 = trk.daughter(1);
    const reco::Candidate* gd1 = nullptr;
    const reco::Candidate* gd2 = nullptr;
    if (twoLayerDecay_) {
      gd1 = d1->daughter(0);
      gd2 = d1->daughter(1);
    }

    eta[it] = trk.eta();
    y[it] = trk.rapidity();
    pt[it] = trk.pt();
    phi[it] = trk.phi();
    flavor[it] = (trk.pdgId() == 0 ? 0.f : static_cast<float>(trk.pdgId() / std::abs(trk.pdgId())));
    mass[it] = trk.mass();
    mva[it] = 0.f;
    if (useAnyMVA_ && mvavalues.isValid() && mvavalues->size() > it) mva[it] = (*mvavalues)[it];
    if (trk.hasUserFloat("D0mva")) mva[it] = trk.userFloat("D0mva");
    if (trk.hasUserFloat("mva")) mva[it] = trk.userFloat("mva");
    massD2[it] = d2->mass();

    if (doGenMatching_) {
      if (twoLayerDecay_) {
        const reco::Candidate* recoD0 = d1;
        const reco::Candidate* recoSlowPi = d2;
        for (unsigned int igen = 0; igen < genRefs.size(); ++igen) {
          const reco::GenParticle* genDStar = genRefs[igen].get();
          const int idxD0 = (std::abs(genDStar->daughter(0)->pdgId()) == kPdgD0) ? 0 : 1;
          const reco::GenParticle* genD0Ref = static_cast<const reco::GenParticle*>(genDStar->daughter(idxD0));
          const reco::GenParticle* genSlowPiRef = static_cast<const reco::GenParticle*>(genDStar->daughter(1 - idxD0));
          const reco::Candidate* genD0 = genD0Ref;
          const reco::Candidate* genSlowPi = genSlowPiRef;
          const bool passD0Match = matchHadron(recoD0, *genD0, true);
          const bool passSlowPiMatch = matchHadron(recoSlowPi, *genSlowPi, false);
          if (!(passD0Match && passSlowPiMatch)) {
            continue;
          }

          const reco::Candidate* genKaon = nullptr;
          const reco::Candidate* genPion = nullptr;
          for (size_t idau = 0; idau < genD0Ref->numberOfDaughters(); ++idau) {
            const reco::Candidate* dau = genD0Ref->daughter(idau);
            if (std::abs(dau->pdgId()) == kPdgGamma) continue;
            if (std::abs(dau->pdgId()) == kPdgKaon && !genKaon) genKaon = dau;
            if (std::abs(dau->pdgId()) == kPdgPion && !genPion) genPion = dau;
          }
          if (!genKaon || !genPion) {
            continue;
          }

          const auto d0Summary = summarizeD0Daughters(genD0Ref);
          const bool validD0Inclusive = (d0Summary.nonGammaCount == 2 && d0Summary.hasKaon && d0Summary.hasPion);
          const bool validD0StrictNoFSR = (validD0Inclusive && d0Summary.gammaCount == 0);
          matchGen_validD0chain_[it] = validD0StrictNoFSR;
          // genDStar is from processGenMatching(), so D* topology is already prefiltered there.
          // inclusive reco-gen match flag (D0 FSR gamma allowed)
          matchGEN[it] = validD0Inclusive;
          // strict non-gamma D* chain flag (for dedicated non-gamma studies)
          matchGen_validDstarChain_[it] = validD0StrictNoFSR;
          if (!matchGEN[it]) continue;
          ++nRecoCandidatesMatched_;

          isSwap[it] = checkSwap(recoD0, *genD0Ref);
          matchGen_D0Dau1_pT_[it] = genKaon->pt();
          matchGen_D0Dau1_eta_[it] = genKaon->eta();
          matchGen_D0Dau1_phi_[it] = genKaon->phi();
          matchGen_D0Dau1_mass_[it] = genKaon->mass();
          matchGen_D0Dau1_y_[it] = genKaon->rapidity();
          matchGen_D0Dau1_charge_[it] = genKaon->charge();
          matchGen_D0Dau1_pdgId_[it] = genKaon->pdgId();
          matchGen_D0Dau2_pT_[it] = genPion->pt();
          matchGen_D0Dau2_eta_[it] = genPion->eta();
          matchGen_D0Dau2_phi_[it] = genPion->phi();
          matchGen_D0Dau2_mass_[it] = genPion->mass();
          matchGen_D0Dau2_y_[it] = genPion->rapidity();
          matchGen_D0Dau2_charge_[it] = genPion->charge();
          matchGen_D0Dau2_pdgId_[it] = genPion->pdgId();
          matchGen_D1pT_[it] = genSlowPiRef->pt();
          matchGen_D1eta_[it] = genSlowPiRef->eta();
          matchGen_D1phi_[it] = genSlowPiRef->phi();
          matchGen_D1mass_[it] = genSlowPiRef->mass();
          matchGen_D1y_[it] = genSlowPiRef->rapidity();
          matchGen_D1charge_[it] = genSlowPiRef->charge();
          matchGen_D1pdgId_[it] = genSlowPiRef->pdgId();
          matchGen_slowPion_dR_[it] = reco::deltaR(*recoSlowPi, *genSlowPi);
          matchGen_D0pT_[it] = genD0Ref->pt();
          matchGen_D0eta_[it] = genD0Ref->eta();
          matchGen_D0phi_[it] = genD0Ref->phi();
          matchGen_D0mass_[it] = genD0Ref->mass();
          matchGen_D0y_[it] = genD0Ref->rapidity();
          matchGen_D0charge_[it] = genD0Ref->charge();
          matchGen_D0pdgId_[it] = genD0Ref->pdgId();
          matchGen_DStarpT_[it] = genDStar->pt();
          matchGen_DStareta_[it] = genDStar->eta();
          matchGen_DStarphi_[it] = genDStar->phi();
          matchGen_DStarmass_[it] = genDStar->mass();
          matchGen_DStary_[it] = genDStar->rapidity();
          matchGen_DStarcharge_[it] = genDStar->charge();
          matchGen_DStarpdgId_[it] = genDStar->pdgId();

          genDecayLength(*genDStar, matchGen_D1decayLength2D_[it], matchGen_D1decayLength3D_[it], matchGen_D1angle2D_[it], matchGen_D1angle3D_[it]);
          getAncestorId(*genDStar, matchGen_D1ancestorId_[it], matchGen_D1ancestorFlavor_[it]);
          gen_agl_abs[it] = matchGen_D1angle3D_[it];
          gen_agl2D_abs[it] = matchGen_D1angle2D_[it];
          gen_dl[it] = matchGen_D1decayLength3D_[it];
          gen_dl2D[it] = matchGen_D1decayLength2D_[it];

          const reco::GenParticle* mother = dynamic_cast<const reco::GenParticle*>(genDStar->mother());
          if (mother) idmom_reco[it] = mother->pdgId();
          const reco::GenParticle* ancestor = mother;
          int depth = 0;
          while (ancestor && depth < 50) {
            ancestor = dynamic_cast<const reco::GenParticle*>(ancestor->mother());
            ++depth;
            if (ancestor && ((std::abs(ancestor->pdgId()) % 1000) / 100 == 5)) {
              idBAnc_reco[it] = ancestor->pdgId();
              break;
            }
          }

          const reco::GenParticle* m1 = dynamic_cast<const reco::GenParticle*>(genKaon->mother());
          const reco::GenParticle* m2 = dynamic_cast<const reco::GenParticle*>(genPion->mother());
          const reco::GenParticle* m3 = dynamic_cast<const reco::GenParticle*>(genSlowPiRef->mother());
          matchGen_D0Dau1_motherPdgId_[it] = m1 ? m1->pdgId() : -99;
          matchGen_D0Dau1_motherNDau_[it] = m1 ? static_cast<int>(m1->numberOfDaughters()) : -99;
          matchGen_D0Dau2_motherPdgId_[it] = m2 ? m2->pdgId() : -99;
          matchGen_D0Dau2_motherNDau_[it] = m2 ? static_cast<int>(m2->numberOfDaughters()) : -99;
          matchGen_D1_motherPdgId_[it] = m3 ? m3->pdgId() : -99;
          matchGen_D1_motherNDau_[it] = m3 ? static_cast<int>(m3->numberOfDaughters()) : -99;
          break;
        }
      } else {
        const reco::GenParticle* matchedGenD0 = nullptr;
        const reco::Candidate* matchedGenKaon = nullptr;
        const reco::Candidate* matchedGenPion = nullptr;
        int matchedIgen = -1;

        for (unsigned int igen = 0; igen < genRefs.size(); ++igen) {
          const reco::GenParticle* theGen = genRefs[igen].get();
          if (!theGen) continue;
          if (!matchHadron(&trk, *theGen, true)) continue;

          const reco::Candidate* genKaon = nullptr;
          const reco::Candidate* genPion = nullptr;
          for (size_t idau = 0; idau < theGen->numberOfDaughters(); ++idau) {
            const reco::Candidate* dau = theGen->daughter(idau);
            if (!dau || std::abs(dau->pdgId()) == kPdgGamma) continue;
            if (std::abs(dau->pdgId()) == kPdgKaon && !genKaon) genKaon = dau;
            if (std::abs(dau->pdgId()) == kPdgPion && !genPion) genPion = dau;
          }
          if (!genKaon || !genPion) continue;
          matchedGenD0 = theGen;
          matchedGenKaon = genKaon;
          matchedGenPion = genPion;
          matchedIgen = static_cast<int>(igen);
          break;
        }

        if (matchedGenD0 && matchedGenKaon && matchedGenPion && matchedIgen >= 0) {
          matchGEN[it] = true;
          ++nRecoCandidatesMatched_;
          isSwap[it] = checkSwap(&trk, *matchedGenD0);
          auto momRef = findMother(genRefs[matchedIgen]);
          if (momRef.isNonnull()) idmom_reco[it] = momRef->pdgId();
          int countAnc = 0;
          auto ancRef = momRef;
          while (ancRef.isNonnull() && countAnc < 50) {
            ancRef = findMother(ancRef);
            ++countAnc;
            if (ancRef.isNonnull() && ((std::abs(ancRef->pdgId()) % 1000) / 100 == 5)) {
              idBAnc_reco[it] = ancRef->pdgId();
              break;
            }
          }
          matchGen_D0pT_[it] = matchedGenD0->pt();
          matchGen_D0eta_[it] = matchedGenD0->eta();
          matchGen_D0phi_[it] = matchedGenD0->phi();
          matchGen_D0mass_[it] = matchedGenD0->mass();
          matchGen_D0y_[it] = matchedGenD0->rapidity();
          matchGen_D0charge_[it] = matchedGenD0->charge();
          matchGen_D0pdgId_[it] = matchedGenD0->pdgId();
          genDecayLength(*matchedGenD0, matchGen_D1decayLength2D_[it], matchGen_D1decayLength3D_[it], matchGen_D1angle2D_[it], matchGen_D1angle3D_[it]);
          getAncestorId(*matchedGenD0, matchGen_D1ancestorId_[it], matchGen_D1ancestorFlavor_[it]);
          gen_agl_abs[it] = matchGen_D1angle3D_[it];
          gen_agl2D_abs[it] = matchGen_D1angle2D_[it];
          gen_dl[it] = matchGen_D1decayLength3D_[it];
          gen_dl2D[it] = matchGen_D1decayLength2D_[it];

          matchGen_D0Dau1_pT_[it] = matchedGenKaon->pt();
          matchGen_D0Dau1_eta_[it] = matchedGenKaon->eta();
          matchGen_D0Dau1_phi_[it] = matchedGenKaon->phi();
          matchGen_D0Dau1_mass_[it] = matchedGenKaon->mass();
          matchGen_D0Dau1_y_[it] = matchedGenKaon->rapidity();
          matchGen_D0Dau1_charge_[it] = matchedGenKaon->charge();
          matchGen_D0Dau1_pdgId_[it] = matchedGenKaon->pdgId();
          matchGen_D0Dau2_pT_[it] = matchedGenPion->pt();
          matchGen_D0Dau2_eta_[it] = matchedGenPion->eta();
          matchGen_D0Dau2_phi_[it] = matchedGenPion->phi();
          matchGen_D0Dau2_mass_[it] = matchedGenPion->mass();
          matchGen_D0Dau2_y_[it] = matchedGenPion->rapidity();
          matchGen_D0Dau2_charge_[it] = matchedGenPion->charge();
          matchGen_D0Dau2_pdgId_[it] = matchedGenPion->pdgId();

          const auto d0Summary = summarizeD0Daughters(matchedGenD0);
          const bool validD0Inclusive = (d0Summary.nonGammaCount == 2 && d0Summary.hasKaon && d0Summary.hasPion);
          const bool validD0StrictNoFSR = (validD0Inclusive && d0Summary.gammaCount == 0);
          matchGen_validD0chain_[it] = validD0StrictNoFSR;
          matchGEN[it] = validD0Inclusive;
        }
      }
    }

    const TVector3 dauvec1(d1->px(), d1->py(), d1->pz());
    const TVector3 dauvec2(d2->px(), d2->py(), d2->pz());
    pt1[it] = d1->pt();
    pt2[it] = d2->pt();
    p1[it] = d1->p();
    p2[it] = d2->p();
    eta1[it] = d1->eta();
    eta2[it] = d2->eta();
    phi1[it] = d1->phi();
    phi2[it] = d2->phi();
    charge1[it] = d1->charge();
    charge2[it] = d2->charge();

    if (doGenMatchingTOF_ && genpars.isValid()) {
      for (unsigned int igen = 0; igen < genpars->size(); ++igen) {
        const reco::GenParticle& gtrk = (*genpars)[igen];
        if (gtrk.pt() < 0.001) continue;
        const int id = gtrk.pdgId();
        const TVector3 gvec(gtrk.px(), gtrk.py(), gtrk.pz());
        if (std::abs(id) != std::abs(pid_) && gtrk.charge()) {
          double dR = gvec.DeltaR(dauvec1);
          if (dR < deltaR_ && std::abs((gtrk.pt() - pt1[it]) / pt1[it]) < 0.5 && gtrk.charge() == charge1[it] && pid1[it] == -99999) pid1[it] = id;
          dR = gvec.DeltaR(dauvec2);
          if (dR < deltaR_ && std::abs((gtrk.pt() - pt2[it]) / pt2[it]) < 0.5 && gtrk.charge() == charge2[it] && pid2[it] == -99999) pid2[it] = id;
        }
        if (std::abs(id) == std::abs(pid_) && gtrk.numberOfDaughters() == 2) {
          const reco::Candidate* gdau1 = gtrk.daughter(0);
          const reco::Candidate* gdau2 = gtrk.daughter(1);
          if (!gdau1 || !gdau2) continue;
          const TVector3 d1vec(gdau1->px(), gdau1->py(), gdau1->pz());
          const TVector3 d2vec(gdau2->px(), gdau2->py(), gdau2->pz());
          double dR = d1vec.DeltaR(dauvec1);
          if (dR < deltaR_ && std::abs((gdau1->pt() - pt1[it]) / pt1[it]) < 0.5 && gdau1->charge() == charge1[it] && pid1[it] == -99999) pid1[it] = gdau1->pdgId();
          dR = d2vec.DeltaR(dauvec1);
          if (dR < deltaR_ && std::abs((gdau2->pt() - pt1[it]) / pt1[it]) < 0.5 && gdau2->charge() == charge1[it] && pid1[it] == -99999) pid1[it] = gdau2->pdgId();
          dR = d1vec.DeltaR(dauvec2);
          if (dR < deltaR_ && std::abs((gdau1->pt() - pt2[it]) / pt2[it]) < 0.5 && gdau1->charge() == charge2[it] && pid2[it] == -99999) pid2[it] = gdau1->pdgId();
          dR = d2vec.DeltaR(dauvec2);
          if (dR < deltaR_ && std::abs((gdau2->pt() - pt2[it]) / pt2[it]) < 0.5 && gdau2->charge() == charge2[it] && pid2[it] == -99999) pid2[it] = gdau2->pdgId();
        }
        if (pid1[it] != -99999 && pid2[it] != -99999) break;
      }
    }

    if (trk.hasUserFloat("VtxChi2")) vtxChi2[it] = trk.userFloat("VtxChi2");
    if (trk.hasUserFloat("VtxNdof")) ndf[it] = trk.userFloat("VtxNdof");
    if (vtxChi2[it] > 0.f && ndf[it] > 0.f) VtxProb[it] = TMath::Prob(vtxChi2[it], ndf[it]);
    if (trk.hasUserFloat("alpha3D")) {
      agl_abs[it] = trk.userFloat("alpha3D");
      agl[it] = std::cos(agl_abs[it]);
    }
    if (trk.hasUserFloat("alpha2D")) {
      agl2D_abs[it] = trk.userFloat("alpha2D");
      agl2D[it] = std::cos(agl2D_abs[it]);
    }
    if (trk.hasUserFloat("decaylength3D")) dl[it] = trk.userFloat("decaylength3D");
    if (trk.hasUserFloat("decaylengthsignif3D")) dlos[it] = trk.userFloat("decaylengthsignif3D");
    if (dlos[it] != 0.f) dlerror[it] = dl[it] / dlos[it];
    if (trk.hasUserFloat("decaylength2D")) dl2D[it] = trk.userFloat("decaylength2D");
    if (trk.hasUserFloat("decaylengthsignif2D")) dlos2D[it] = trk.userFloat("decaylengthsignif2D");

    const CC* d1CC = (twoLayerDecay_ ? dynamic_cast<const CC*>(d1) : nullptr);
    if (twoLayerDecay_) {
      if (d1CC && d1CC->hasUserFloat("track3DDCA")) trk3Ddca[it] = d1CC->userFloat("track3DDCA");
      if (d1CC && d1CC->hasUserFloat("track3DDCAErr")) trk3DdcaErr[it] = d1CC->userFloat("track3DDCAErr");
      if (d1CC && d1CC->hasUserFloat("dca3D")) dca3D[it] = d1CC->userFloat("dca3D");
      if (d1CC && d1CC->hasUserFloat("dca3DErr")) dca3DErr[it] = d1CC->userFloat("dca3DErr");
    } else {
      if (trk.hasUserFloat("track3DDCA")) trk3Ddca[it] = trk.userFloat("track3DDCA");
      if (trk.hasUserFloat("track3DDCAErr")) trk3DdcaErr[it] = trk.userFloat("track3DDCAErr");
      if (trk.hasUserFloat("dca3D")) dca3D[it] = trk.userFloat("dca3D");
      if (trk.hasUserFloat("dca3DErr")) dca3DErr[it] = trk.userFloat("dca3DErr");
    }
    dca2D[it] = dl2D[it] * std::sin(agl2D_abs[it]);

    const reco::TrackRef dau1 = d1->get<reco::TrackRef>();
    const reco::TrackRef dau2 = d2->get<reco::TrackRef>();
    if (dau1.isNonnull()) {
      trkquality1[it] = dau1->quality(reco::TrackBase::highPurity);
      ptErr1[it] = dau1->ptError();
      nhit1[it] = dau1->numberOfValidHits();
      trkChi1[it] = dau1->normalizedChi2();
      if (dEdxHandle1.isValid()) H2dedx1[it] = (*dEdxHandle1)[dau1].dEdx();
      if (dEdxHandle2.isValid()) T4dedx1[it] = (*dEdxHandle2)[dau1].dEdx();
      if (!twoLayerDecay_) {
        if (trk.hasUserFloat("posDauDzSig")) dzos1[it] = trk.userFloat("posDauDzSig");
        if (trk.hasUserFloat("posDauDxySig")) dxyos1[it] = trk.userFloat("posDauDxySig");
        if (trk.hasUserFloat("posDauDz")) dzval1[it] = trk.userFloat("posDauDz");
        if (trk.hasUserFloat("posDauDxy")) dxyval1[it] = trk.userFloat("posDauDxy");
      }
    }
    if (dau2.isNonnull()) {
      trkquality2[it] = dau2->quality(reco::TrackBase::highPurity);
      ptErr2[it] = dau2->ptError();
      nhit2[it] = dau2->numberOfValidHits();
      trkChi2[it] = dau2->normalizedChi2();
      if (dEdxHandle1.isValid()) H2dedx2[it] = (*dEdxHandle1)[dau2].dEdx();
      if (dEdxHandle2.isValid()) T4dedx2[it] = (*dEdxHandle2)[dau2].dEdx();
      if (twoLayerDecay_) {
        if (trk.hasUserFloat("slowPiDzSig")) dzos2[it] = trk.userFloat("slowPiDzSig");
        if (trk.hasUserFloat("slowPiDxySig")) dxyos2[it] = trk.userFloat("slowPiDxySig");
        if (trk.hasUserFloat("slowPiDz")) dzval2[it] = trk.userFloat("slowPiDz");
        if (trk.hasUserFloat("slowPiDxy")) dxyval2[it] = trk.userFloat("slowPiDxy");
      } else {
        if (trk.hasUserFloat("negDauDzSig")) dzos2[it] = trk.userFloat("negDauDzSig");
        if (trk.hasUserFloat("negDauDxySig")) dxyos2[it] = trk.userFloat("negDauDxySig");
        if (trk.hasUserFloat("negDauDz")) dzval2[it] = trk.userFloat("negDauDz");
        if (trk.hasUserFloat("negDauDxy")) dxyval2[it] = trk.userFloat("negDauDxy");
      }
    }

    if (twoLayerDecay_) {
      const reco::TrackRef gdau1 = gd1->get<reco::TrackRef>();
      const reco::TrackRef gdau2 = gd2->get<reco::TrackRef>();
      if (gdau1.isNonnull()) {
        grand_trkquality1[it] = gdau1->quality(reco::TrackBase::highPurity);
        grand_ptErr1[it] = gdau1->ptError();
        grand_nhit1[it] = gdau1->numberOfValidHits();
        grand_trkChi1[it] = gdau1->normalizedChi2();
        if (dEdxHandle1.isValid()) grand_H2dedx1[it] = (*dEdxHandle1)[gdau1].dEdx();
        if (dEdxHandle2.isValid()) grand_T4dedx1[it] = (*dEdxHandle2)[gdau1].dEdx();
      }
      if (gdau2.isNonnull()) {
        grand_trkquality2[it] = gdau2->quality(reco::TrackBase::highPurity);
        grand_ptErr2[it] = gdau2->ptError();
        grand_nhit2[it] = gdau2->numberOfValidHits();
        grand_trkChi2[it] = gdau2->normalizedChi2();
        if (dEdxHandle1.isValid()) grand_H2dedx2[it] = (*dEdxHandle1)[gdau2].dEdx();
        if (dEdxHandle2.isValid()) grand_T4dedx2[it] = (*dEdxHandle2)[gdau2].dEdx();
      }

      grand_mass[it] = d1->mass();
      grand_pt1[it] = gd1->pt();
      grand_pt2[it] = gd2->pt();
      grand_mass1[it] = gd1->mass();
      grand_mass2[it] = gd2->mass();
      grand_p1[it] = gd1->p();
      grand_p2[it] = gd2->p();
      grand_eta1[it] = gd1->eta();
      grand_eta2[it] = gd2->eta();
      grand_phi1[it] = gd1->phi();
      grand_phi2[it] = gd2->phi();
      grand_charge1[it] = gd1->charge();
      grand_charge2[it] = gd2->charge();

      if (d1CC) {
        if (d1CC->hasUserFloat("posDauDzSig")) grand_dzos1[it] = d1CC->userFloat("posDauDzSig");
        if (d1CC->hasUserFloat("posDauDxySig")) grand_dxyos1[it] = d1CC->userFloat("posDauDxySig");
        if (d1CC->hasUserFloat("negDauDzSig")) grand_dzos2[it] = d1CC->userFloat("negDauDzSig");
        if (d1CC->hasUserFloat("negDauDxySig")) grand_dxyos2[it] = d1CC->userFloat("negDauDxySig");
        if (d1CC->hasUserFloat("VtxChi2")) grand_vtxChi2[it] = d1CC->userFloat("VtxChi2");
        if (d1CC->hasUserFloat("VtxNdof")) grand_ndf[it] = d1CC->userFloat("VtxNdof");
        if (grand_vtxChi2[it] > 0.f && grand_ndf[it] > 0.f) grand_VtxProb[it] = TMath::Prob(grand_vtxChi2[it], grand_ndf[it]);
        if (d1CC->hasUserFloat("alpha3D")) {
          grand_agl_abs[it] = d1CC->userFloat("alpha3D");
          grand_agl[it] = std::cos(grand_agl_abs[it]);
        }
        if (d1CC->hasUserFloat("alpha2D")) {
          grand_agl2D_abs[it] = d1CC->userFloat("alpha2D");
          grand_agl2D[it] = std::cos(grand_agl2D_abs[it]);
        }
        if (d1CC->hasUserFloat("decaylength3D")) grand_dl[it] = d1CC->userFloat("decaylength3D");
        if (d1CC->hasUserFloat("decaylengthsignif3D")) grand_dlos[it] = d1CC->userFloat("decaylengthsignif3D");
        if (grand_dlos[it] != 0.f) grand_dlerror[it] = grand_dl[it] / grand_dlos[it];
        if (d1CC->hasUserFloat("decaylength2D")) grand_dl2D[it] = d1CC->userFloat("decaylength2D");
        if (d1CC->hasUserFloat("decaylengthsignif2D")) grand_dlos2D[it] = d1CC->userFloat("decaylengthsignif2D");
      }
    }
  }

}

void PATCompositeTreeProducer6::fillRECO(const edm::Event& iEvent, const edm::EventSetup&) {
  ++nEventsFillRECO_;
  if (!doRecoNtuple_) return;
  if (!hasCompositeCandidatesToken_) return;

  edm::Handle<reco::VertexCollection> vertices;
  iEvent.getByToken(tok_offlinePV_, vertices);

  edm::Handle<reco::TrackCollection> tracks;
  iEvent.getByToken(tok_generalTrk_, tracks);

  edm::Handle<CCC> v0candidates;
  iEvent.getByToken(tok_compositeCandidates_, v0candidates);
  if (!v0candidates.isValid()) {
    edm::LogWarning("PAT6GenMatching") << "Composite candidate collection is invalid in fillRECO.";
    candSize = 0;
    return;
  }

  edm::Handle<MVACollection> mvavalues;
  if (useAnyMVA_) {
    iEvent.getByToken(tok_mvaValues_, mvavalues);
    if (mvavalues.isValid()) assert(mvavalues->size() == v0candidates->size());
  }

  edm::Handle<reco::GenParticleCollection> genpars;
  if (doGenMatching_ || doGenMatchingTOF_) iEvent.getByToken(tok_genParticle_, genpars);

  edm::Handle<edm::ValueMap<reco::DeDxData>> dEdxHandle1;
  iEvent.getByToken(tok_dedx1_, dEdxHandle1);

  edm::Handle<edm::ValueMap<reco::DeDxData>> dEdxHandle2;
  iEvent.getByToken(tok_dedx2_, dEdxHandle2);

  processCentralityInfo(iEvent);
  processEventPlaneInfo(iEvent);
  processVertexAndTrackInfo(vertices, tracks);

  std::vector<reco::GenParticleRef> genRefs;
  if (doGenMatching_) genRefs = processGenMatching(genpars);

  processCandidates(v0candidates.product(), mvavalues, genRefs, dEdxHandle1, dEdxHandle2, iEvent, vertices, genpars);
}

void PATCompositeTreeProducer6::fillGEN(const edm::Event& iEvent, const edm::EventSetup&) {
  ++nEventsFillGEN_;

  edm::Handle<reco::GenParticleCollection> genpars;
  iEvent.getByToken(tok_genParticle_, genpars);

  const auto genRefs = processGenMatching(genpars);
  if (!doGenNtuple_) return;
  if (!PATCompositeNtuple_) {
    edm::LogWarning("PAT6GenMatching") << "PATCompositeNtuple is null while doGenNtuple=true; skipping Fill().";
    return;
  }

  const unsigned int nGenRaw = static_cast<unsigned int>(genRefs.size());
  const unsigned int nGen = std::min<unsigned int>(nGenRaw, static_cast<unsigned int>(kMaxGenCand));
  if (nGenRaw > nGen) {
    edm::LogWarning("PAT6GenMatching") << "genRefs size (" << nGenRaw << ") exceeds kMaxGenCand (" << kMaxGenCand << "); truncating.";
  }
  candSize_gen = static_cast<int>(nGen);

  auto resetGenSlot = [&](unsigned int idx) {
    mass_gen[idx] = kInvalidValue;
    pt_gen[idx] = kInvalidValue;
    eta_gen[idx] = kInvalidValue;
    phi_gen[idx] = kInvalidValue;
    status_gen[idx] = -99;
    pdgId_gen[idx] = -99;
    charge_gen[idx] = -99;
    idmom[idx] = -99;
    y_gen[idx] = kInvalidValue;
    iddau1[idx] = -99;
    iddau2[idx] = -99;

    gen_D0pT_[idx] = kInvalidValue;
    gen_D0eta_[idx] = kInvalidValue;
    gen_D0phi_[idx] = kInvalidValue;
    gen_D0mass_[idx] = kInvalidValue;
    gen_D0y_[idx] = kInvalidValue;
    gen_D0charge_[idx] = -99;
    gen_D0pdgId_[idx] = -99;
    gen_D0ancestorId_[idx] = -99;
    gen_D0ancestorFlavor_[idx] = -99;

    gen_D0Dau1_pT_[idx] = kInvalidValue;
    gen_D0Dau1_eta_[idx] = kInvalidValue;
    gen_D0Dau1_phi_[idx] = kInvalidValue;
    gen_D0Dau1_mass_[idx] = kInvalidValue;
    gen_D0Dau1_y_[idx] = kInvalidValue;
    gen_D0Dau1_charge_[idx] = -99;
    gen_D0Dau1_pdgId_[idx] = -99;

    gen_D0Dau2_pT_[idx] = kInvalidValue;
    gen_D0Dau2_eta_[idx] = kInvalidValue;
    gen_D0Dau2_phi_[idx] = kInvalidValue;
    gen_D0Dau2_mass_[idx] = kInvalidValue;
    gen_D0Dau2_y_[idx] = kInvalidValue;
    gen_D0Dau2_charge_[idx] = -99;
    gen_D0Dau2_pdgId_[idx] = -99;

    gen_D1pT_[idx] = kInvalidValue;
    gen_D1eta_[idx] = kInvalidValue;
    gen_D1phi_[idx] = kInvalidValue;
    gen_D1mass_[idx] = kInvalidValue;
    gen_D1y_[idx] = kInvalidValue;
    gen_D1charge_[idx] = -99;
    gen_D1pdgId_[idx] = -99;
    gen_validDstarChain_[idx] = false;
    gen_validD0chain_[idx] = false;
  };

  for (unsigned int igen = 0; igen < nGen; ++igen) {
    resetGenSlot(igen);
    const auto& genRef = genRefs[igen];
    if (genRef.isNull()) continue;

    const reco::Candidate* theGen = genRef.get();
    if (!theGen) continue;

    mass_gen[igen] = theGen->mass();
    pt_gen[igen] = theGen->pt();
    eta_gen[igen] = theGen->eta();
    phi_gen[igen] = theGen->phi();
    y_gen[igen] = theGen->rapidity();
    status_gen[igen] = theGen->status();
    pdgId_gen[igen] = theGen->pdgId();
    charge_gen[igen] = theGen->charge();
    if (theGen->numberOfMothers() > 0 && theGen->mother()) idmom[igen] = theGen->mother()->pdgId();
    if (decayInGen_) {
      if (theGen->numberOfDaughters() > 0 && theGen->daughter(0)) iddau1[igen] = theGen->daughter(0)->pdgId();
      if (theGen->numberOfDaughters() > 1 && theGen->daughter(1)) iddau2[igen] = theGen->daughter(1)->pdgId();
    }
    getAncestorId(*theGen, gen_D0ancestorId_[igen], gen_D0ancestorFlavor_[igen]);

    if (twoLayerDecay_) {
      const reco::Candidate* genD0 = nullptr;
      const reco::Candidate* genSlowPi = nullptr;
      int dstarGammaCount = 0;
      int dstarNonGammaCount = 0;
      int dstarD0Count = 0;
      int dstarPiCount = 0;
      for (size_t idau = 0; idau < theGen->numberOfDaughters(); ++idau) {
        const reco::Candidate* dau = theGen->daughter(idau);
        if (!dau) continue;
        const int absId = std::abs(dau->pdgId());
        if (absId == kPdgGamma) {
          ++dstarGammaCount;
          continue;
        }
        ++dstarNonGammaCount;
        if (absId == kPdgD0) {
          ++dstarD0Count;
          if (!genD0) genD0 = dau;
        } else if (absId == kPdgPion) {
          ++dstarPiCount;
          if (!genSlowPi) genSlowPi = dau;
        }
      }

      if (genD0) {
        gen_D0mass_[igen] = genD0->mass();
        gen_D0pT_[igen] = genD0->pt();
        gen_D0eta_[igen] = genD0->eta();
        gen_D0phi_[igen] = genD0->phi();
        gen_D0y_[igen] = genD0->rapidity();
        gen_D0pdgId_[igen] = genD0->pdgId();
        gen_D0charge_[igen] = genD0->charge();
      }
      if (genSlowPi) {
        gen_D1mass_[igen] = genSlowPi->mass();
        gen_D1pT_[igen] = genSlowPi->pt();
        gen_D1eta_[igen] = genSlowPi->eta();
        gen_D1phi_[igen] = genSlowPi->phi();
        gen_D1y_[igen] = genSlowPi->rapidity();
        gen_D1pdgId_[igen] = genSlowPi->pdgId();
        gen_D1charge_[igen] = genSlowPi->charge();
      }

      int d0GammaCount = 0;
      int d0NonGammaCount = 0;
      const reco::Candidate* d0Kaon = nullptr;
      const reco::Candidate* d0Pion = nullptr;
      if (genD0) {
        for (size_t idau = 0; idau < genD0->numberOfDaughters(); ++idau) {
          const reco::Candidate* dau = genD0->daughter(idau);
          if (!dau) continue;
          const int absId = std::abs(dau->pdgId());
          if (absId == kPdgGamma) {
            ++d0GammaCount;
            continue;
          }
          ++d0NonGammaCount;
          if (absId == kPdgKaon && !d0Kaon) d0Kaon = dau;
          if (absId == kPdgPion && !d0Pion) d0Pion = dau;
        }
      }
      if (d0Kaon) {
        gen_D0Dau1_pT_[igen] = d0Kaon->pt();
        gen_D0Dau1_eta_[igen] = d0Kaon->eta();
        gen_D0Dau1_phi_[igen] = d0Kaon->phi();
        gen_D0Dau1_mass_[igen] = d0Kaon->mass();
        gen_D0Dau1_y_[igen] = d0Kaon->rapidity();
        gen_D0Dau1_charge_[igen] = d0Kaon->charge();
        gen_D0Dau1_pdgId_[igen] = d0Kaon->pdgId();
      }
      if (d0Pion) {
        gen_D0Dau2_pT_[igen] = d0Pion->pt();
        gen_D0Dau2_eta_[igen] = d0Pion->eta();
        gen_D0Dau2_phi_[igen] = d0Pion->phi();
        gen_D0Dau2_mass_[igen] = d0Pion->mass();
        gen_D0Dau2_y_[igen] = d0Pion->rapidity();
        gen_D0Dau2_charge_[igen] = d0Pion->charge();
        gen_D0Dau2_pdgId_[igen] = d0Pion->pdgId();
      }

      const bool d0TopologyOK = genD0 && ((d0GammaCount == 0 && genD0->numberOfDaughters() == 2) ||
                                          (d0GammaCount == 1 && genD0->numberOfDaughters() == 3));
      gen_validD0chain_[igen] = (d0TopologyOK && d0NonGammaCount == 2 && d0Kaon && d0Pion);
      gen_validDstarChain_[igen] = (dstarGammaCount == 0 && dstarNonGammaCount == 2 &&
                                    dstarD0Count == 1 && dstarPiCount == 1 &&
                                    gen_validD0chain_[igen]);
    } else {
      const reco::Candidate* genD0 = theGen;
      gen_D0mass_[igen] = genD0->mass();
      gen_D0pT_[igen] = genD0->pt();
      gen_D0eta_[igen] = genD0->eta();
      gen_D0phi_[igen] = genD0->phi();
      gen_D0y_[igen] = genD0->rapidity();
      gen_D0pdgId_[igen] = genD0->pdgId();
      gen_D0charge_[igen] = genD0->charge();

      int d0GammaCount = 0;
      int d0NonGammaCount = 0;
      const reco::Candidate* d0Kaon = nullptr;
      const reco::Candidate* d0Pion = nullptr;
      for (size_t idau = 0; idau < genD0->numberOfDaughters(); ++idau) {
        const reco::Candidate* dau = genD0->daughter(idau);
        if (!dau) continue;
        const int absId = std::abs(dau->pdgId());
        if (absId == kPdgGamma) {
          ++d0GammaCount;
          continue;
        }
        ++d0NonGammaCount;
        if (absId == kPdgKaon && !d0Kaon) d0Kaon = dau;
        if (absId == kPdgPion && !d0Pion) d0Pion = dau;
      }
      if (d0Kaon) {
        gen_D0Dau1_pT_[igen] = d0Kaon->pt();
        gen_D0Dau1_eta_[igen] = d0Kaon->eta();
        gen_D0Dau1_phi_[igen] = d0Kaon->phi();
        gen_D0Dau1_mass_[igen] = d0Kaon->mass();
        gen_D0Dau1_y_[igen] = d0Kaon->rapidity();
        gen_D0Dau1_charge_[igen] = d0Kaon->charge();
        gen_D0Dau1_pdgId_[igen] = d0Kaon->pdgId();
      }
      if (d0Pion) {
        gen_D0Dau2_pT_[igen] = d0Pion->pt();
        gen_D0Dau2_eta_[igen] = d0Pion->eta();
        gen_D0Dau2_phi_[igen] = d0Pion->phi();
        gen_D0Dau2_mass_[igen] = d0Pion->mass();
        gen_D0Dau2_y_[igen] = d0Pion->rapidity();
        gen_D0Dau2_charge_[igen] = d0Pion->charge();
        gen_D0Dau2_pdgId_[igen] = d0Pion->pdgId();
      }

      const bool d0TopologyOK = ((d0GammaCount == 0 && genD0->numberOfDaughters() == 2) ||
                                 (d0GammaCount == 1 && genD0->numberOfDaughters() == 3));
      gen_validD0chain_[igen] = (d0TopologyOK && d0NonGammaCount == 2 && d0Kaon && d0Pion);
      gen_validDstarChain_[igen] = false;
    }
  }
}
void PATCompositeTreeProducer6::analyze(const edm::Event& iEvent, const edm::EventSetup& iSetup) {
  ++nEventsProcessed_;
  processRunInfo(iEvent);
  if (doRecoNtuple_) fillRECO(iEvent, iSetup);
  if (doGenNtuple_ || doGenMatching_) fillGEN(iEvent, iSetup);
  if (PATCompositeNtuple_ && (doRecoNtuple_ || doGenNtuple_)) PATCompositeNtuple_->Fill();
}

void PATCompositeTreeProducer6::endJob() {}

