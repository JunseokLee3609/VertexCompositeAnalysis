void PATCompositeTreeProducer6::processRunInfo(const edm::Event& iEvent) {
  runNb = 0;
  lsNb = 0;
  eventNb = 0;
  if (!doRunInfo_) return;
  runNb = iEvent.id().run();
  eventNb = iEvent.id().event();
  lsNb = iEvent.luminosityBlock();
}

void PATCompositeTreeProducer6::processVertexAndTrackInfo(const edm::Handle<reco::VertexCollection>& vertices,
                                                          const edm::Handle<reco::TrackCollection>& tracks) {
  bestvz = kInvalidValue;
  bestvx = kInvalidValue;
  bestvy = kInvalidValue;
  Ntrkoffline = 0;
  if (!vertices.isValid() || vertices->empty() || !tracks.isValid()) return;

  double bestvzError = kInvalidValue;
  const reco::Vertex& vtx = (*vertices)[0];
  bestvz = vtx.z();
  bestvx = vtx.x();
  bestvy = vtx.y();
  bestvzError = vtx.zError();

  if (multMax_ != -1 && multMin_ != -1) {
    for (unsigned it = 0; it < tracks->size(); ++it) {
      const reco::Track& trk = (*tracks)[it];
      math::XYZPoint bestvtx(bestvx, bestvy, bestvz);
      const double dzvtx = trk.dz(bestvtx);
      const double dxyvtx = trk.dxy(bestvtx);
      const double dzerror = std::sqrt(trk.dzError() * trk.dzError() + bestvzError * bestvzError);
      const double dxyerror = trk.dxyError(bestvtx, vtx.covariance());
      if (!trk.quality(reco::TrackBase::highPurity)) continue;
      if (std::abs(trk.ptError()) / trk.pt() > 0.10) continue;
      if (std::abs(dzvtx / dzerror) > 3) continue;
      if (std::abs(dxyvtx / dxyerror) > 3) continue;
      const double eta = trk.eta();
      const double pt = trk.pt();
      if (std::abs(eta) > 2.4) continue;
      if (pt <= 0.4) continue;
      Ntrkoffline++;
    }
  }
}



